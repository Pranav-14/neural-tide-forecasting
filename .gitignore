# Ignore all raw, benchmark, and external datasets
data/
*.csv
*.tsv
*.parquet
*.h5
*.hdf5
*.zip
*.tar.gz

# Ignore internal docs, project overviews, briefs, and research report
docs/
report/

# Ignore baseline prediction CSV outputs
experiments/baseline_predictions/
experiments/predictions/
*.csv

# Ignore large model checkpoints
*.pt
*.pth
*.ckpt
*.onnx

